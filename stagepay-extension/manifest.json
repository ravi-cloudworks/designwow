{
  "manifest_version": 3,
  "name": "StagePay Director - AI Video Production Assistant for UGC Creators",
  "version": "0.3.0",
  "description": "Generate premium, client-ready UGC videos without wasting AI credits: compiled Flow/ChatGPT prompts, references, deliverable upload",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open StagePay Director",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "tabs", "clipboardWrite", "downloads"],
  "host_permissions": ["https://stagepay.pages.dev/*"]
}
