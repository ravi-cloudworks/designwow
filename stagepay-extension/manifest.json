{
  "manifest_version": 3,
  "name": "StagePay Bridge - Google Flow Connector for UGC Video Creators",
  "version": "0.2.0",
  "description": "Bridges your StagePay project with Google Flow/ChatGPT: compiled prompts, reference images, and one-click deliverable upload.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open StagePay Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "tabs", "clipboardWrite", "downloads"],
  "host_permissions": ["https://stagepay.pages.dev/*"]
}
